<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Theme applied to the Android Window while the process is starting on Android 12+ (API 31+) -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/splash_background_light</item>
        <!-- Display our brand splash logo fully visible with inset padding inside Android 12's mask -->
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon_inset</item>
        <item name="android:windowSplashScreenBackground">@color/splash_background_light</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
