<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="10dp"
    android:background="@drawable/widget_bg">

    <!-- Top Bar: Wallet Name + Balance -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/widget_wallet_icon"
            android:layout_width="13dp"
            android:layout_height="13dp"
            android:src="@drawable/ic_widget_card"
            android:layout_marginEnd="5dp" />

        <TextView
            android:id="@+id/widget_wallet_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Main Wallet"
            android:textColor="@color/widget_primary_cyan"
            android:textSize="12sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_balance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1,250,000 IQD"
            android:textColor="@color/widget_text_white"
            android:textSize="17sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- Cashflow Strip: Income (GREEN) & Expenses (RED) Badges -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="6dp">

        <!-- Income Badge: GREEN (+ دخل اليوم) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:background="@drawable/widget_card_bg"
            android:padding="5dp"
            android:gravity="center_vertical"
            android:layout_marginEnd="3dp">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_widget_arrow_down_left"
                android:layout_marginEnd="5dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_income_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="دخل اليوم"
                    android:textColor="@color/widget_subtext"
                    android:textSize="8.5sp"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/widget_today_income"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+100,000 IQD"
                    android:textColor="@color/widget_income_green"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>
        </LinearLayout>

        <!-- Expenses Badge: RED (- مصاريف اليوم) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:background="@drawable/widget_card_bg"
            android:padding="5dp"
            android:gravity="center_vertical"
            android:layout_marginStart="3dp">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_widget_arrow_up_right"
                android:layout_marginEnd="5dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_expenses_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="مصاريف اليوم"
                    android:textColor="@color/widget_subtext"
                    android:textSize="8.5sp"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/widget_today_expenses"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-25,000 IQD"
                    android:textColor="@color/widget_expense_red"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Recent Transactions Header -->
    <TextView
        android:id="@+id/widget_recent_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="أحدث المعاملات"
        android:textColor="@color/widget_subtext"
        android:textSize="10.5sp"
        android:textStyle="bold" />

    <!-- Transactions List Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginTop="3dp">

        <!-- Tx 1 -->
        <LinearLayout
            android:id="@+id/widget_tx_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/widget_card_bg"
            android:padding="5dp"
            android:layout_marginBottom="3dp"
            android:gravity="center_vertical"
            android:visibility="gone">

            <ImageView
                android:id="@+id/widget_tx_1_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:background="@drawable/widget_icon_expense_bg"
                android:src="@drawable/ic_widget_cart"
                android:padding="3dp"
                android:layout_marginEnd="6dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_tx_1_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Coffee"
                    android:textColor="@color/widget_text_white"
                    android:textSize="10.5sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/widget_tx_1_category"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Food &amp; Drinks"
                    android:textColor="@color/widget_subtext"
                    android:textSize="8.5sp"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_tx_1_amount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="-5,000 IQD"
                android:textColor="@color/widget_expense_red"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Tx 2 -->
        <LinearLayout
            android:id="@+id/widget_tx_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/widget_card_bg"
            android:padding="5dp"
            android:layout_marginBottom="3dp"
            android:gravity="center_vertical"
            android:visibility="gone">

            <ImageView
                android:id="@+id/widget_tx_2_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:background="@drawable/widget_icon_expense_bg"
                android:src="@drawable/ic_widget_cart"
                android:padding="3dp"
                android:layout_marginEnd="6dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_tx_2_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Groceries"
                    android:textColor="@color/widget_text_white"
                    android:textSize="10.5sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/widget_tx_2_category"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Groceries"
                    android:textColor="@color/widget_subtext"
                    android:textSize="8.5sp"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_tx_2_amount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="-35,000 IQD"
                android:textColor="@color/widget_expense_red"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Tx 3 -->
        <LinearLayout
            android:id="@+id/widget_tx_3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/widget_card_bg"
            android:padding="5dp"
            android:gravity="center_vertical"
            android:visibility="gone">

            <ImageView
                android:id="@+id/widget_tx_3_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:background="@drawable/widget_icon_income_bg"
                android:src="@drawable/ic_widget_income_cash"
                android:padding="3dp"
                android:layout_marginEnd="6dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_tx_3_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Salary"
                    android:textColor="@color/widget_text_white"
                    android:textSize="10.5sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/widget_tx_3_category"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Salary"
                    android:textColor="@color/widget_subtext"
                    android:textSize="8.5sp"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_tx_3_amount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+500,000 IQD"
                android:textColor="@color/widget_income_green"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Empty State -->
        <TextView
            android:id="@+id/widget_tx_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="لا توجد معاملات مؤخراً"
            android:textColor="@color/widget_subtext"
            android:textSize="10.5sp"
            android:visibility="visible" />
    </LinearLayout>

    <!-- Bottom Action Bar: [Expense (-)] [Income (+)] [Transfer (⇄)] -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="5dp">

        <TextView
            android:id="@+id/widget_btn_expense"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_weight="1"
            android:text="- مصروف"
            android:textColor="@color/widget_expense_red"
            android:textSize="10sp"
            android:textStyle="bold"
            android:gravity="center"
            android:background="@drawable/widget_badge_expense"
            android:layout_marginEnd="3dp" />

        <TextView
            android:id="@+id/widget_btn_income"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_weight="1"
            android:text="+ دخل"
            android:textColor="@color/widget_income_green"
            android:textSize="10sp"
            android:textStyle="bold"
            android:gravity="center"
            android:background="@drawable/widget_badge_income"
            android:layout_marginEnd="3dp" />

        <TextView
            android:id="@+id/widget_btn_transfer"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_weight="1"
            android:text="⇄ تحويل"
            android:textColor="@color/widget_transfer_blue"
            android:textSize="10sp"
            android:textStyle="bold"
            android:gravity="center"
            android:background="@drawable/widget_badge_transfer" />
    </LinearLayout>
</LinearLayout>
