<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="10dp"
    android:background="@drawable/widget_bg">

    <!-- Top Bar: Wallet Name + Quick Action Buttons (Expense, Income, Transfer) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="top">

        <!-- Wallet Name & Current Balance -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/widget_wallet_icon"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:src="@drawable/ic_widget_card"
                    android:layout_marginEnd="4dp" />

                <TextView
                    android:id="@+id/widget_wallet_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Main Wallet"
                    android:textColor="@color/widget_primary_cyan"
                    android:textSize="11.5sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_balance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="1,250,000 IQD"
                android:textColor="@color/widget_text_white"
                android:textSize="18sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- Quick Action Buttons: Expense (-), Income (+), Transfer (⇄) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_btn_expense"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:text="- مصروف"
                android:textColor="@color/widget_expense_red"
                android:textSize="9.5sp"
                android:textStyle="bold"
                android:gravity="center"
                android:paddingStart="7dp"
                android:paddingEnd="7dp"
                android:background="@drawable/widget_badge_expense"
                android:layout_marginEnd="3dp" />

            <TextView
                android:id="@+id/widget_btn_income"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:text="+ دخل"
                android:textColor="@color/widget_income_green"
                android:textSize="9.5sp"
                android:textStyle="bold"
                android:gravity="center"
                android:paddingStart="7dp"
                android:paddingEnd="7dp"
                android:background="@drawable/widget_badge_income"
                android:layout_marginEnd="3dp" />

            <TextView
                android:id="@+id/widget_btn_transfer"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:text="⇄ تحويل"
                android:textColor="@color/widget_transfer_blue"
                android:textSize="9.5sp"
                android:textStyle="bold"
                android:gravity="center"
                android:paddingStart="7dp"
                android:paddingEnd="7dp"
                android:background="@drawable/widget_badge_transfer" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Bottom Row: Cashflow Cards (Income Today: GREEN, Expenses Today: RED) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- Income Card: GREEN (+ دخل اليوم) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:background="@drawable/widget_card_bg"
            android:padding="6dp"
            android:gravity="center_vertical"
            android:layout_marginEnd="3dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_widget_arrow_down_left"
                android:background="@drawable/widget_icon_income_bg"
                android:padding="3dp"
                android:layout_marginEnd="5dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_income_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="دخل اليوم"
                    android:textColor="@color/widget_subtext"
                    android:textSize="8.5sp"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/widget_today_income"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+100,000 IQD"
                    android:textColor="@color/widget_income_green"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>
        </LinearLayout>

        <!-- Expenses Card: RED (- مصاريف اليوم) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:background="@drawable/widget_card_bg"
            android:padding="6dp"
            android:gravity="center_vertical"
            android:layout_marginStart="3dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_widget_arrow_up_right"
                android:background="@drawable/widget_icon_expense_bg"
                android:padding="3dp"
                android:layout_marginEnd="5dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_expenses_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="مصاريف اليوم"
                    android:textColor="@color/widget_subtext"
                    android:textSize="8.5sp"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/widget_today_expenses"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-25,000 IQD"
                    android:textColor="@color/widget_expense_red"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
